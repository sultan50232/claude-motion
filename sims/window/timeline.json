{
 "duration": 46.52,
 "sentences": [
  {
   "i": 0,
   "start": 0.7,
   "end": 3.568,
   "text": "قد ركبت طيارة ولاحظت الثُّقب الصغير اللي في النافذة؟"
  },
  {
   "i": 1,
   "start": 4.018,
   "end": 6.746,
   "text": "تدري إن الثُّقب هذا له وظيفة مهمة جدًا؟"
  },
  {
   "i": 2,
   "start": 7.296,
   "end": 11.638,
   "text": "الطائرة وهي ترتفع، ينخفض ضغط الهواء خارجها بشكل كبير."
  },
  {
   "i": 3,
   "start": 12.088,
   "end": 16.314,
   "text": "لكن داخل الطائرة، يتم الحفاظ على ضغط مناسب للركاب."
  },
  {
   "i": 4,
   "start": 17.164,
   "end": 21.669,
   "text": "عشان كذا، نوافذ الطائرات تتكون عادة من عدة طبقات."
  },
  {
   "i": 5,
   "start": 22.169,
   "end": 30.377,
   "text": "الطبقة الخارجية تتحمل فرق الضغط، والطبقة الوسطى فيها ثُقب صغير يساعد على موازنة الضغط بين الطبقات."
  },
  {
   "i": 6,
   "start": 30.877,
   "end": 37.03,
   "text": "والثُّقب يساعد أيضًا على تقليل تجمع الرطوبة والضباب داخل النافذة."
  },
  {
   "i": 7,
   "start": 37.58,
   "end": 43.919,
   "text": "يعني الشي اللي تحسبه مجرد ثُقب صغير، هو جزء من تصميم هندسي مدروس!"
  }
 ],
