  "lines": [
    {"t": 0.15, "end": 2.55, "text": "ورقةٌ بسيطة… غيّرت تاريخ العالم.", "accent": ["غيّرت"]},
    {"t": 2.75, "end": 5.25, "text": "وسرُّها بدأ في ساحة معركة!", "accent": ["معركة!"]},
    {"t": 6.0, "end": 8.95, "text": "عام ٧٥١م… جيش العباسيين يواجه جيش الصين.", "accent": ["٧٥١م…"]},
    {"t": 9.2, "end": 13.0, "text": "عند نهر طلاس، في قلب آسيا الوسطى.", "accent": ["طلاس،"]},
    {"t": 13.8, "end": 16.9, "text": "تقول الروايات إن بين الأسرى صُنّاعَ ورق.", "accent": ["صُنّاعَ", "ورق."]},
    {"t": 17.2, "end": 20.6, "text": "حملوا سرًّا أخفته الصين قرونًا… إلى سمرقند.", "accent": ["سمرقند."]},
    {"t": 21.4, "end": 24.4, "text": "ومن سمرقند… سار الورق على طريق الحرير.", "accent": ["طريق", "الحرير."]},
    {"t": 24.7, "end": 28.0, "text": "حتى وصل إلى عاصمة الدنيا: بغداد.", "accent": ["بغداد."]},
    {"t": 28.8, "end": 32.0, "text": "نحو عام ٧٩٤م… قامت أول مطحنة ورق في بغداد.", "accent": ["مطحنة", "ورق"]},
    {"t": 32.4, "end": 35.5, "text": "صار الكتاب رخيصًا… وامتلأت المكتبات.", "accent": ["رخيصًا…"]},
    {"t": 35.8, "end": 38.3, "text": "وازدهر بيتُ الحكمة.", "accent": ["بيتُ", "الحكمة."]},
    {"t": 38.9, "end": 41.9, "text": "ومن بغداد… انتقل الورق إلى العالم كلّه.", "accent": ["العالم"]},
    {"t": 42.2, "end": 46.5, "text": "تابعنا… فالقصة لم تنتهِ بعد.", "accent": ["تابعنا…"]}
  ],
