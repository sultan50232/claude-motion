  "lines": [
    {
      "t": 0.15,
      "end": 4.12,
      "text": "ورقةٌ بسيطة… غيّرت تاريخ العالم.",
      "accent": [
        "غيّرت"
      ]
    },
    {
      "t": 4.37,
      "end": 7.72,
      "text": "وسرُّها بدأ في ساحة معركة!",
      "accent": [
        "معركة!"
      ]
    },
    {
      "t": 8.47,
      "end": 15.05,
      "text": "عام ٧٥١م… جيش العباسيين يواجه جيش الصين.",
      "say": "عامَ سبعِمئةٍ وواحدٍ وخمسين… جيشُ العباسيين يواجه جيشَ الصين.",
      "accent": [
        "٧٥١م…"
      ]
    },
    {
      "t": 15.3,
      "end": 19.15,
      "text": "عند نهر طلاس، في قلب آسيا الوسطى.",
      "accent": [
        "طلاس،"
      ]
    },
    {
      "t": 19.95,
      "end": 23.79,
      "text": "تقول الروايات إن بين الأسرى صُنّاعَ ورق.",
      "accent": [
        "صُنّاعَ",
        "ورق."
      ]
    },
    {
      "t": 24.09,
      "end": 28.65,
      "text": "حملوا سرًّا أخفته الصين قرونًا… إلى سمرقند.",
      "accent": [
        "سمرقند."
      ]
    },
    {
      "t": 29.45,
      "end": 33.75,
      "text": "ومن سمرقند… سار الورق على طريق الحرير.",
      "accent": [
        "طريق",
        "الحرير."
      ]
    },
    {
      "t": 34.05,
      "end": 37.85,
      "text": "حتى وصل إلى عاصمة الدنيا: بغداد.",
      "accent": [
        "بغداد."
      ]
    },
    {
      "t": 38.65,
      "end": 45.83,
      "text": "نحو عام ٧٩٤م… قامت أول مطحنة ورق في بغداد.",
      "say": "نحوَ عامِ سبعِمئةٍ وأربعةٍ وتسعين… قامت أولُ مطحنةِ ورقٍ في بغداد.",
      "accent": [
        "مطحنة",
        "ورق"
      ]
    },
    {
      "t": 46.23,
      "end": 50.4,
      "text": "صار الكتاب رخيصًا… وامتلأت المكتبات.",
      "accent": [
        "رخيصًا…"
      ]
    },
    {
      "t": 50.7,
      "end": 52.95,
      "text": "وازدهر بيتُ الحكمة.",
      "accent": [
        "بيتُ",
        "الحكمة."
      ]
    },
    {
      "t": 53.55,
      "end": 57.87,
      "text": "ومن بغداد… انتقل الورق إلى العالم كلّه.",
      "accent": [
        "العالم"
      ]
    },
    {
      "t": 58.17,
      "end": 62.87,
      "text": "تابعنا… فالقصة لم تنتهِ بعد.",
      "accent": [
        "تابعنا…"
      ]
    }
  ],
